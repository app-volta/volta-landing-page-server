DB_URL=jdbc:postgresql://SEU_HOST:SUA_PORTA/NOME_DO_BANCO?sslmode=require
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha


# Envio de email de recuperacao de senha (SMTP)
SMTP_HOST=smtp.seu_provedor.com
SMTP_PORT=587
SMTP_USER=seu_usuario
SMTP_PASSWORD=sua_senha
SMTP_FROM=no-reply@seudominio.com
SMTP_STARTTLS=true

# URL publica da aplicacao, sem barra no final (ex: https://volta.exemplo.com/volta)
APP_BASE_URL=http://localhost:8080/volta

# Em dev, o link de recuperacao aparece no log quando o SMTP nao esta configurado
APP_ENV=dev

# Admin global criado automaticamente no primeiro start quando ainda nao existe
# A senha precisa ter 8+ caracteres, uma letra maiuscula e um caractere especial
ADMIN_NAME=Administrador do Sistema
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=TroqueEstaSenha1@
# A tabela users exige vinculo com empresa ou cooperativa.
# Informe uma empresa existente para o admin global ou deixe vazio para usar a primeira.
ADMIN_COMPANY_ID=1
