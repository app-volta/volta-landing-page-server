<%@ page pageEncoding="UTF-8" %>
<nav class="nav">
    <div class="menu">
        <input type="checkbox" id="menu-toggle" aria-label="Alternar menu">

        <div class="nav-logo">
            <a href="${pageContext.request.contextPath}${homePath}" title="Ir para o início" aria-label="Ir para o início">
                <img src="${pageContext.request.contextPath}/assets/img/content/Logo_VOLTA_branco.png" alt="VOLTA Logo">
            </a>
            <label for="menu-toggle" class="material-symbols-outlined" aria-label="Abrir menu">menu</label>
        </div>

        <div class="nav-links">
            <c:if test="${systemAdmin}">
                <a class="link-pagina" href="${pageContext.request.contextPath}${homePath}">Painel</a>
                <c:forEach var="section" items="${adminSections}">
                    <a class="link-pagina" href="${pageContext.request.contextPath}${section.path}"><c:out value="${section.label}"/></a>
                </c:forEach>
            </c:if>
            <c:if test="${companyUser}">
                <a class="link-pagina" href="${pageContext.request.contextPath}${homePath}">Painel</a>

                <a class="link-pagina" href="${pageContext.request.contextPath}/area?action=list">Unidades</a>
                <a class="link-pagina" href="${pageContext.request.contextPath}/usuario?action=list">Funcionários</a>
                <a class="link-pagina" href="${pageContext.request.contextPath}/ocorrencia?action=list">Ocorrências</a>
                <a class="link-pagina" href="${pageContext.request.contextPath}/coleta?action=list">Coletas</a>
            </c:if>
            <c:if test="${cooperativeUser and not systemAdmin}">
                <a class="link-pagina" href="${pageContext.request.contextPath}/coleta?action=list">Coletas</a>
            </c:if>
            <span class="usuario-logado"><c:out value="${sessionScope.loggedUser.name}"/></span>
            <form class="form-sair" method="post" action="${pageContext.request.contextPath}/logout">
                <button type="submit" class="btn-sair">Sair</button>
            </form>
        </div>
    </div>
</nav>
<%@ include file="/WEB-INF/jspf/confirm-dialog.jspf" %>
